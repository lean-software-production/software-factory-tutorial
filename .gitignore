**/node_modules/
**/dist/
**/.subagents/
.worktrees/
*.log
*.swp
# tutorial/factory/ holds the learner's own work, and is tracked so a mistake is
# recoverable. Everything that is not theirs to keep goes in a .tmp/ beside the
# script that writes it: the engine's state, and the evidence, findings,
# baselines, commit messages and iteration records a run regenerates.
tutorial/factory/**/.tmp/
tutorial/.tutorial/
# Existing checkouts may still have pre-migration learner-local state at the root.
factory/**/.tmp/
.tutorial/
# Screenshots are approval tests: the .approved.png beside each case is committed, and a failing
# run leaves a .received.png next to it to be compared and then approved or discarded.
tutorial-engine/test/visual/*.received.png
tutorial-engine/test/.tmp/
.superpowers/
.pi/git/
.pi/settings.json
.local/
evals/reports/
.yaks
