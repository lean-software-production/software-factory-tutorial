**/node_modules/
**/dist/
**/.subagents/
.worktrees/
*.log
*.swp
# tutorial/workspaces/ holds authored learner workspace templates and is tracked so a
# session can copy a clean baseline. Everything that is not theirs to keep goes in a
# .tmp/ beside the script that writes it: the engine's state, and the evidence,
# findings, baselines, commit messages and iteration records a run regenerates.
tutorial/workspaces/**/factory/**/.tmp/
tutorial/.tutorial/
# Existing checkouts may still have pre-migration learner-local state at the root.
factory/**/.tmp/
.tutorial/
# Screenshots are approval tests: the .approved.png beside each case is committed, and a failing
# run leaves a .received.png next to it to be compared and then approved or discarded.
tutorial-engine/test/visual/*.received.png
tutorial-engine/test/.tmp/
.superpowers/
.pi/git/
.pi/settings.json
.local/
# Historical root eval reports from older runner locations; no active runner writes here.
# Keep this ignore so old checkout artifacts do not churn while tracked plans stay untouched.
evals/reports/
# Authored-workbook live eval reports (owner: root).
evals/workbook/reports/
# Current live synthetic engine-mechanics eval reports (owner: tutorial-engine).
tutorial-engine/evals/reports/
.yaks

# Agent worktrees. Throwaway checkouts; ignoring only these keeps a shared
# .claude/settings.json trackable if one is ever added.
.claude/worktrees/
