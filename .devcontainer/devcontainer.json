{
	"name": "software-factory-tutorial",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"mounts": [
		"source=software-factory-tutorial-state,target=/home/vscode/.tutorial-state,type=volume",
		// The checkout is bind-mounted from the host, so mask host macOS
		// node_modules with Linux volumes at every npm install location. The
		// devcontainer id keeps separate worktrees from sharing native packages.
		"source=${devcontainerId}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
		"source=${devcontainerId}-tutorial-engine-node_modules,target=${containerWorkspaceFolder}/tutorial-engine/node_modules,type=volume",
		"source=${devcontainerId}-tutorial-calculator-node_modules,target=${containerWorkspaceFolder}/tutorial/calculator/node_modules,type=volume"
	],
	"containerEnv": {
		"PI_CODING_AGENT_DIR": "/home/vscode/.tutorial-state/pi-agent",
		// The main tutor's model. The fast block helper and the `pi -p` doer the
		// lessons drive are separate roles: the main tutor teaches, the block
		// helper gives quick read-only hints, and the doer is meant to be cheap,
		// fast, and fallible. The block helper normally follows Pi's own pick
		// unless BLOCK_TUTOR_MODEL is exported; the doer default is seeded into
		// the state volume by post-create.sh. These values assume the OpenCode
		// Zen provider this image is built around; a participant who logged in
		// elsewhere falls back to Pi's own pick, and `npm run setup` reports
		// which. Override the main tutor for one shell with
		// `export TUTOR_MODEL=...`.
		"TUTOR_MODEL": "opencode-go/deepseek-v4-flash"
	},
	// An OpenCode Zen key on the host authenticates Pi without an interactive
	// /login. It lives in remoteEnv, not containerEnv, so rotating the host
	// value needs only a reopen rather than a rebuild, and the key is never
	// baked into the container's creation metadata. Hosts without the variable
	// pass an empty string, which Pi reads as "no key" and ignores, so the
	// `pi` + /login path keeps working untouched.
	"remoteEnv": {
		"OPENCODE_API_KEY": "${localEnv:OPENCODE_API_KEY}"
	},
	"forwardPorts": [4310],
	"portsAttributes": {
		"4310": {
			"label": "tutor",
			"onAutoForward": "openBrowser"
		}
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"remoteUser": "vscode"
}
