{
  "name": "Validation loops tutorial",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "forwardPorts": [4310],
  "portsAttributes": {
    "4310": {
      "label": "Tutorial engine",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "OPENCODE_API_KEY": "${localEnv:OPENCODE_API_KEY}"
  },
  "postCreateCommand": "npm --prefix tutorial-engine ci && npm --prefix natural-language-calculator ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
