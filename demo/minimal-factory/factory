#!/usr/bin/env bash
# The factory: the one command you run.
#
# It owns the checks that must happen before anything is spent — the argument is
# a file, the file is somewhere this line is allowed to work, the tree is clean,
# the tools exist — and then hands the job to the orchestrator. Nothing here
# calls a model. A preflight that costs money is a preflight you skip.
#
# Usage: factory <file-in-calculator>
set -euo pipefail

. "$(dirname "$0")/lib/paths.sh"
. "$ROOT/lib/say.sh"

if [ $# -ne 1 ]; then
  echo "usage: factory <file-in-calculator>" >&2
  echo "example: ./factory ../../calculator/src/index.ts" >&2
  exit 2
fi

# --- The argument is a file ---------------------------------------------------

if [ ! -f "$1" ]; then
  fail "not a file: $1"
  exit 2
fi
target="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

# --- ...somewhere this line is allowed to work --------------------------------

case "$target" in
  "$CALC"/*) ;;
  *)
    fail "target must be inside $CALC"
    note "This demo refactors the tutorial's calculator and nothing else."
    exit 2
    ;;
esac

# --- ...with nothing already in the way ---------------------------------------

# The committer stages all of `calculator/`. Uncommitted work there would be
# swept into the line's commit as though a station had done it, so a dirty tree
# is refused rather than worked around.
if [ -n "$(git -C "$REPO" status --porcelain -- calculator)" ]; then
  fail "calculator/ has uncommitted changes"
  note "The line commits everything under calculator/, so it needs a clean start."
  note "Commit or stash them first:"
  note "    git -C $REPO status -- calculator"
  exit 2
fi

# --- ...and the tools to do it ------------------------------------------------

missing=()
for tool in pi jq node npm git; do
  if ! command -v "$tool" > /dev/null 2>&1; then
    missing+=("$tool")
  fi
done
if [ "${#missing[@]}" -gt 0 ]; then
  fail "missing required tools: ${missing[*]}"
  exit 2
fi

# --- ...starting from green ---------------------------------------------------

# The line's whole judgement of a change is "do the tests still pass". Starting
# from a red suite means every round fails for a reason no station can fix, and
# nothing stops it except the round cap — ten model calls later. Ten seconds
# here is cheaper than finding out at the end.
printf '\n'
note "factory: checking the calculator starts green…"
baseline="$("$ROOT/stations/test-runner")"
case "$baseline" in
  "TESTS: PASS"*)
    ok "$baseline"
    ;;
  *)
    fail "the calculator's tests do not pass yet — $baseline"
    note "The line cannot tell a break it caused from one that was already here."
    note "Full report: ${RUN#"$REPO"/}/test-report.txt"
    note "If the failure mentions an ExperimentalWarning on stderr, it is node:"
    note "    node --version    # this needs 24.2 or newer"
    exit 2
    ;;
esac

# --- Hand off -----------------------------------------------------------------

printf '\n'
note "factory: target ${target#"$REPO"/}"
# pi 0.74 prints --version to stderr, 0.83 to stdout, and a version manager's
# shim may print a banner ahead of either. Take both streams and pick the last
# thing shaped like a version.
pi_version="$(pi --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | tail -1)"
note "factory: calculator/ is clean, pi ${pi_version:-unknown}, jq $(jq --version)"
flow factory orchestrator

exec "$ROOT/orchestrator" "$target"
