#!/usr/bin/env bash
# The orchestrator: one doer pass, then validate-and-heal until the change is
# acceptable or the line gives up.
#
#   doer ─► ┌─ test-runner ─► validator ─► healer ─┐
#           └──────────────────────────────────────┘  up to MAX_ROUNDS times
#                            └─► committer
#
# It runs no model itself. Every decision it makes is made from a file some
# station wrote: the test report, the verdict, the commit message. That is the
# whole trick — the orchestrator is deterministic, and the parts that are not
# deterministic are the parts it can read the output of.
#
# Usage: orchestrator <absolute-path-to-target-file>
#        (run `factory <file>` instead; it does the checks this assumes)
set -euo pipefail

. "$(dirname "$0")/lib/paths.sh"
. "$ROOT/lib/say.sh"

target="$1"
in_calculator="${target#"$CALC"/}"
MAX_ROUNDS="${FACTORY_MAX_ROUNDS:-5}"

trap spin_stop EXIT INT TERM

# A fresh run keeps no records from the last one, so the totals at the end are
# this run's totals.
rm -rf "$RUN"
mkdir -p "$EVENTS"

"$ROOT/lib/material.sh" "The target" /dev/stdin > "$RUN/target.md" <<EOF
The file to change is \`$in_calculator\`, relative to your working directory.
EOF

total_so_far() { "$ROOT/lib/cost-of.sh" "$EVENTS"/*.jsonl; }

# Run after every station that can write. Nothing downstream sees a change the
# guard has not already narrowed to the target file.
guard_scope() {
  local strayed started took
  rail_start scope-guard "deterministic"
  started=$(date +%s%N)
  strayed=$("$ROOT/stations/scope-guard" "$in_calculator")
  took=$(elapsed "$started")
  if [ -n "$strayed" ]; then
    rail_warn "reverted $(printf '%s\n' "$strayed" | wc -l) outside the target" "$took"
    while IFS= read -r path; do rail_note "$path"; done <<< "$strayed"
  else
    rail_ok "nothing outside the target" "$took"
  fi
}

# run_tests LABEL — the deterministic station, on the rail
run_tests() {
  local started took
  rail_start "$1" "deterministic"
  started=$(date +%s%N)
  tests_said="$("$ROOT/stations/test-runner")"
  took=$(elapsed "$started")
  case "$tests_said" in
    "TESTS: PASS"*) rail_ok   "${tests_said#TESTS: PASS — }" "$took" ;;
    *)              rail_fail "${tests_said#TESTS: FAIL — }" "$took" ;;
  esac
}

report_total() {
  local files=("$EVENTS"/*.jsonl) rounds="round"
  [ "$1" -eq 1 ] || rounds="rounds"
  printf '  %s%d model calls · $%.2f · %d %s · %s%s\n' \
    "$C_DIM" "${#files[@]}" "$(total_so_far)" "$1" "$rounds" "$(elapsed "$RUN_STARTED")" "$C_OFF"
  printf '  %srecords in %s%s\n' "$C_DIM" "${EVENTS#"$REPO"/}" "$C_OFF"
}

RUN_STARTED=$(date +%s%N)
cap_label="rounds"
[ "$MAX_ROUNDS" -eq 1 ] && cap_label="round"
rail_head "line" "$(printf '%s · cap %d %s' "$in_calculator" "$MAX_ROUNDS" "$cap_label")"
rail_gap

# --- Can the line start? ------------------------------------------------------

# The line's whole judgement of a change is "do the tests still pass", so it has
# to know they passed before anyone touched anything. Starting from a red suite
# means every round fails for a reason no station can fix, and nothing stops it
# but the round cap — ten model calls later.
#
# This belongs to the line rather than to the factory. It is the line's own
# standard, checked by the line's own station, and it costs nothing.
run_tests baseline

case "$tests_said" in
  "TESTS: PASS"*) ;;
  *)
    rail_note "the line cannot start"
    printf '\n'
    fail "the calculator's tests do not pass yet"
    note "The line could not tell a break it caused from one already here."
    note "Full report: ${RUN#"$REPO"/}/test-report.txt"
    if grep -q "ExperimentalWarning" "$RUN/test-report.txt" 2>/dev/null; then
      note ""
      note "That is a node version problem, and probably not the node you think."
      note "The failing test spawns npx from the repository root, so what matters"
      note "is what node resolves to *there*, not in your shell:"
      note "    (cd $REPO && node --version)    # needs 24.2 or newer"
      note "With a version manager, pin it in a file the whole repository is"
      note "under — a pin inside demo/minimal-factory/ does not reach the root."
    fi
    exit 2
    ;;
esac
rail_gap

# --- The doer -----------------------------------------------------------------

"$ROOT/lib/station.sh" doer "$EVENTS/0-doer.jsonl" "$RUN/target.md"
"$ROOT/lib/text-of.sh" "$EVENTS/0-doer.jsonl" > "$RUN/doer-report.txt"
rail_gap
guard_scope
rail_gap

# --- Validate, heal, validate again -------------------------------------------

round=1
while :; do

  rail_start "round $round/$MAX_ROUNDS"
  rail_in

  run_tests tests
  "$ROOT/lib/material.sh" "The test report" "$RUN/test-report.txt" > "$RUN/tests.md"

  git -C "$REPO" diff -- calculator > "$RUN/diff.txt"
  "$ROOT/lib/material.sh" "The diff" "$RUN/diff.txt" > "$RUN/diff.md"

  "$ROOT/lib/station.sh" validator "$EVENTS/$round-validator.jsonl" \
    "$RUN/target.md" "$RUN/diff.md" "$RUN/tests.md"
  "$ROOT/lib/text-of.sh" "$EVENTS/$round-validator.jsonl" > "$RUN/findings.txt"

  # The validator's summary is its verdict. Nothing to compress.
  verdict=$("$ROOT/lib/verdict-of.sh" "$RUN/findings.txt")
  rail_note "${verdict#VERDICT: }"

  if [ "$verdict" = "VERDICT: PASS" ]; then
    rail_out
    rail_gap
    break
  fi

  if [ "$round" -ge "$MAX_ROUNDS" ]; then
    rail_out
    rail_end
    printf '\n'
    fail "gave up after $MAX_ROUNDS validation rounds. Nothing was committed."
    note "The change is still in your working tree. To discard it:"
    note "    git -C $REPO restore -- calculator"
    note "The last findings are in ${RUN#"$REPO"/}/findings.txt"
    report_total "$round"
    exit 1
  fi

  rail_gap
  "$ROOT/lib/material.sh" "The validator's findings" "$RUN/findings.txt" \
    > "$RUN/findings.md"
  "$ROOT/lib/station.sh" healer "$EVENTS/$round-healer.jsonl" \
    "$RUN/target.md" "$RUN/findings.md" "$RUN/tests.md"
  "$ROOT/lib/text-of.sh" "$EVENTS/$round-healer.jsonl" > "$RUN/healer-report.txt"
  rail_gap
  guard_scope
  rail_out
  rail_gap

  round=$((round + 1))
done

# --- The commit ---------------------------------------------------------------

"$ROOT/lib/material.sh" "The validator's findings" "$RUN/findings.txt" \
  > "$RUN/findings.md"
"$ROOT/lib/station.sh" committer "$EVENTS/$round-committer.jsonl" \
  "$RUN/target.md" "$RUN/diff.md" "$RUN/findings.md"
"$ROOT/lib/text-of.sh" "$EVENTS/$round-committer.jsonl" > "$RUN/commit-message.txt"

# The committer wrote the message; the commit itself is the orchestrator's, and
# `-- calculator` is what keeps it to the work the line actually did.
git -C "$REPO" add -- calculator
git -C "$REPO" commit -q -F "$RUN/commit-message.txt"

# The committer's summary is the commit it produced — a sha and a subject the
# line already holds, so no model is asked to describe what git can state.
rail_note "$(git -C "$REPO" rev-parse --short HEAD) $(git -C "$REPO" log -1 --format=%s)"
rail_end

printf '\n'
report_total "$round"
