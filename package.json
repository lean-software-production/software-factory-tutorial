{
  "name": "validation-loops-tutorial",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-led tutorial for building software validation loops.",
  "type": "module",
  "engines": {
    "node": ">=24.2.0 <25",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "tutorial/workspaces/refactor-line/calculator",
    "tutorial-engine"
  ],
  "scripts": {
    "start": "npm run tutorial:workbook",
    "setup": "node scripts/setup.mjs",
    "test:onboarding": "node --test test/onboarding.test.mjs",
    "check:eval:workbook": "tsc -p evals/workbook/tsconfig.json",
    "test:eval:workbook": "vitest run evals/workbook/test/*.test.ts",
    "eval:engine": "npm run --workspace=tutorial-engine eval --",
    "eval:release": "npm run --workspace=tutorial-engine eval:release --",
    "eval": "npm run eval:engine --",
    "check": "npm run test:onboarding && npm run --workspace=tutorial-engine check && npm run --workspace=tutorial-engine check:workbook && npm run --workspace=tutorial/workspaces/refactor-line/calculator test && npm run check:visual",
    "tutorial:workbook": "node scripts/tutorial-workbook.mjs",
    "check:visual": "npm run --workspace=tutorial-engine test:visual",
    "approve:visual": "node scripts/approve-visual.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0"
  }
}
