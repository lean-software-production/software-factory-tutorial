{
  "name": "validation-loops-tutorial",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-led tutorial for building software validation loops.",
  "type": "module",
  "engines": {
    "node": ">=24.2.0 <25",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "tutorial/workspaces/refactor-line/calculator",
    "tutorial-engine"
  ],
  "scripts": {
    "start": "node scripts/tutorial-workbook.mjs",
    "setup": "node scripts/setup.mjs",
    "test:onboarding": "node --test test/*.test.mjs",
    "check:workbook": "npm run --workspace=tutorial-engine check:workbook -- ../tutorial",
    "eval:engine": "npm run --workspace=tutorial-engine eval --",
    "eval:release": "npm run --workspace=tutorial-engine eval:release --",
    "eval": "npm run eval:engine --",
    "check": "npm run test:fast",
    "tutorial:workbook": "node scripts/tutorial-workbook.mjs",
    "check:visual": "npm run --workspace=tutorial-engine test:visual",
    "approve:visual": "node scripts/approve-visual.mjs",
    "test": "node scripts/run-local-tests.mjs test",
    "test:fast": "node scripts/run-local-tests.mjs test:fast",
    "test:engine": "node scripts/run-local-tests.mjs test:engine",
    "test:engine:fast": "npm run --workspace=tutorial-engine test:fast --",
    "test:workbook:fast": "node scripts/run-local-tests.mjs test:workbook:fast"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0"
  }
}
