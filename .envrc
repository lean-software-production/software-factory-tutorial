source_env_if_exists .local/secrets.envrc

# Use the OpenCode key supplied by local secrets unless the shell chooses another tutor.
export TUTOR_MODEL=openai-codex/gpt-5.6-luna
export PRACTICE_COACH_MODEL=openai-codex/gpt-5.3-codex-spark

# A live evaluator needs an explicit judge; local secrets may override this.
export EVAL_JUDGE_MODEL="${EVAL_JUDGE_MODEL:-gpt-5.6-terra}"
