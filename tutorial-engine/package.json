{
  "name": "@lean-software-production/tutorial-engine",
  "version": "0.1.0",
  "description": "A local browser-led refactoring tutorial engine powered by Pi's SDK",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tutorial-engine": "./dist/workbook/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.2.0 <25"
  },
  "scripts": {
    "build:typescript": "rm -rf dist && tsc -p tsconfig.json",
    "build": "npm run build:typescript && npm run build:web:workbook",
    "start": "node dist/workbook/cli.js",
    "test": "vitest run --root .",
    "test:workbook-ux:analyser": "tsx test/workbook-ux/synthetic-contract.mts",
    "check:eval": "tsc -p evals/tsconfig.json",
    "test:eval": "vitest run --root . evals/test/*.test.ts",
    "eval": "npm run build && tsx evals/run.ts",
    "eval:release": "npm run eval -- --release",
    "test:workbook-ux": "tsx test/workbook-ux/run.mts --no-ai",
    "test:workbook-ux:record": "tsx test/workbook-ux/record.mts --record-only",
    "test:workbook-ux:deterministic": "tsx test/workbook-ux/run.mts --no-ai",
    "test:workbook-ux:ai": "tsx test/workbook-ux/run.mts --ai",
    "browser:install": "playwright install chromium",
    "browser:install:ci": "playwright install --with-deps chromium",
    "browser:smoke": "tsx test/browser-smoke.mts",
    "test:visual": "node scripts/test-visual.mjs",
    "check": "npm run build:typescript && npm run test:fast && npm run check:workbook-terminal-image",
    "postinstall": "node scripts/fix-node-pty-helper.mjs",
    "prepublishOnly": "npm run check",
    "dev:workbook": "npm run build:web:workbook && tsx src/workbook/cli.ts",
    "check:workbook": "tsx src/workbook/check.ts",
    "build:web:workbook": "vite build",
    "build:workbook-terminal": "docker build --tag lean-software-production/workbook-terminal:latest --file docker/workbook-terminal.Dockerfile .",
    "check:workbook-terminal-image": "npm run build:workbook-terminal && bash scripts/check-workbook-terminal-image.sh",
    "lint": "eslint web-workbook/src",
    "format:css": "prettier --write 'web-workbook/src/**/*.css'",
    "check:format": "prettier --check 'web-workbook/src/**/*.css'",
    "test:fast": "npm run lint && tsc -p tsconfig.check.json && npm run check:eval && npm run test && npm run build:web:workbook && npm run browser:smoke"
  },
  "//rendering-pins": "The libraries below with exact versions are what draws the workbook: @xterm/* the terminal band, @codemirror/* the editor band, react/react-dom/react-markdown/remark-gfm the DOM, highlight.js and rehype-highlight the code colours, mermaid the diagrams, vite and @vitejs/plugin-react the bundle, and playwright the Chromium that screenshots it. A bump to any of them can move pixels in the approved screenshots, so they carry no range: deterministic approvals require reviewing those upgrades as deliberate edits to this file instead of letting rendering drift through a lockfile alone.",
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "canvas-confetti": "1.9.4",
    "highlight.js": "11.11.1",
    "mermaid": "11.17.2",
    "node-pty": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "typebox": "^1.1.0",
    "vite": "7.3.6",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.0"
  }
}
